# Public canonical origin (no trailing slash).
SITE_URL=https://burmolda.ru
PORT=3000
# Use production behind your HTTPS proxy; use development for local HTTP.
NODE_ENV=production
# Generate once and keep stable across restarts.
SESSION_SECRET=replace-with-a-long-random-secret

# Google Cloud > APIs & Services > Credentials > OAuth client (Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://burmolda.ru/auth/google/callback

# Local Google testing: also authorize http://localhost:3000/auth/google/callback
# and use that exact value for GOOGLE_REDIRECT_URI (NODE_ENV=development).
# Email delivery uses the existing mailer.js configuration for signup/recovery
# and additional verification of non-Gmail/non-Workspace Google email addresses.
